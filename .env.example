# ============================================================
# pxid_h5 服务端环境变量模板（联调/部署用，不涉密）
# 复制为 .env（本地）或 .env.local（联调）后填值；生产密钥走 ECS pm2 env 注入，绝不进 git。
# 权威契约：docs/handoff/2026-08-20-discover-d-integration-spec.md v1.3
# 联调数据包：2026-08-24-D侧本地联调数据包.md
# ============================================================

# ---- ToC 中台对接（SEC-01：账号体系真身份 / 封禁同步）----
# 网关地址：本地联调用 http://127.0.0.1:48090 或同办公室 http://172.16.11.3:48090
#           生产另填公司 ToC 网关（如 https://toc.appin.site），密钥走线下强随机交换
TOC_BASE_URL=http://172.16.11.3:48090

# client_id 规范固定值（无需改）
TOC_CLIENT_ID=pxid_discover

# client_secret（= HMAC 密钥）。联调用下方 dev 值；生产必须换强随机，走 ECS env，不写本文件
TOC_CLIENT_SECRET=toc-dev-2026-08-24-discover-app-secret

# ban-sync 共享 HMAC 密钥（D↔ToC 同构，联调与 client_secret 同值；生产另配）
TOC_BANSYNC_SECRET=toc-dev-2026-08-24-discover-app-secret

# 以下为可选覆盖（一般留空走默认拼接）：
# TOC_USERINFO_URL=http://172.16.11.3:48090/toc-api/open/discover/userinfo
# TOC_EXCHANGE_URL=http://172.16.11.3:48090/toc-api/auth/exchange-token
# TOC_BANSYNC_URL=http://172.16.11.3:48090/toc-api/open/discover/ban-sync

# ---- 八戒自签用户 token（演示态）：配了才启用自签校验，未配则仅检查 token 非空（过渡降级）----
# 生产用 ToC userinfo，无需此值
# USER_TOKEN_SECRET=

# ---- 运营后台管理员 token（仅运营接口用）----
# ADMIN_TOKEN=
